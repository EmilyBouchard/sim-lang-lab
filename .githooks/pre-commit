#!/bin/sh
# Pre-commit: verify formatting for each language that has staged changes.
# Works on Linux and Windows (Git for Windows runs hooks with its bundled sh/bash).
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency:  git commit --no-verify
#
# The check runs on what will be committed, not on the working tree. Tracked files with unstaged
# edits are copied aside, replaced by their staged version for the check, and copied back
# byte-for-byte afterwards (also on failure or Ctrl-C). Untracked files are left alone.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

backup=""
modified_list=""
deleted_list=""

restore() {
  [ -n "$backup" ] || return 0
  ok=1
  if [ -n "$modified_list" ]; then
    printf '%s\n' "$modified_list" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      cp -p "$backup/$f" "$f" || exit 1
    done || ok=0
  fi
  if [ -n "$deleted_list" ]; then
    printf '%s\n' "$deleted_list" | while IFS= read -r f; do
      [ -n "$f" ] && rm -f "$f"
    done
  fi
  if [ "$ok" = 1 ]; then
    rm -rf "$backup"
  else
    echo "pre-commit: could not restore all of your unstaged edits. The originals are in $backup" >&2
  fi
  backup=""
}
trap restore EXIT INT TERM

# `git commit -a` and `git commit <paths>` run this hook against a temporary index. There the
# working tree is the best thing to check, so do not swap files around.
case "${GIT_INDEX_FILE:-}" in
  ''|*/index|index) can_swap=1 ;;
  *) can_swap=0 ;;
esac

if [ "$can_swap" = 1 ]; then
  modified_list=$(git diff --name-only --diff-filter=M)
  deleted_list=$(git diff --name-only --diff-filter=D)
  if [ -n "$modified_list$deleted_list" ]; then
    backup=$(mktemp -d) || { echo "pre-commit: cannot create a temp dir" >&2; exit 1; }
    ok=1
    if [ -n "$modified_list" ]; then
      printf '%s\n' "$modified_list" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        mkdir -p "$backup/$(dirname "$f")" && cp -p "$f" "$backup/$f" || exit 1
      done || ok=0
    fi
    if [ "$ok" = 1 ]; then
      # Check out the staged version of every tracked file that differs from it.
      printf '%s\n%s\n' "$modified_list" "$deleted_list" | while IFS= read -r f; do
        [ -n "$f" ] && git checkout-index -f -- "$f"
      done
    else
      echo "pre-commit: could not back up unstaged edits; checking the working tree instead." >&2
      rm -rf "$backup"; backup=""; modified_list=""; deleted_list=""
    fi
  fi
fi

fail=0
for lang in cpp csharp haskell; do
  if printf '%s\n' "$staged" | grep -q "^$lang/"; then
    echo "pre-commit: checking $lang formatting..."
    bash ./format.sh "$lang" --check || fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo >&2
  echo "pre-commit: formatting check failed. Run './format.sh' to fix, re-stage, and commit again." >&2
  exit 1
fi
